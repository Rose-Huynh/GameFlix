# Copy to application-local.properties (ignored by Git), and replace placeholders.
spring.datasource.url=jdbc:mysql://localhost:3306/gameflix
spring.datasource.username=YOUR_MYSQL_USER
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.jpa.hibernate.ddl-auto=update

# Generate with: openssl rand -base64 32
app.jwt.secret=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTE_KEY
app.jwt.lifetime=PT15M
app.frontend-origin=http://localhost:3000
